{
  "expo": {
    "name": "Killfeed",
    "slug": "killfeed-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "killfeedmobile",
    "userInterfaceStyle": "dark",
    "ios": {},
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.goomesdev.killfeedmobile"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0B",
          "image": "./src/assets/images/splash-logo.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a2077c52-0c06-487e-848e-c169720321b7"
      }
    }
  }
}
